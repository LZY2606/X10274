{
  "case_id": "dicom-geometry-calibration-bench",
  "title": "DICOM 体系标定台：切片几何、FrameOfReference 与序列多解",
  "narrative": "医学影像研究组导入去标识的 DICOM metadata 与像素文件，按空间几何组成可复核的 series/volume 候选",
  "baseline": {
    "dir": "baseline",
    "series_instance_uid": "1.2.826.0.1.3680043.9.7433.10.1",
    "frame_of_reference_uid": "1.2.826.0.1.3680043.9.7433.20.1",
    "slices": 6,
    "spacing_mm": 1.0,
    "pixel_spacing_mm": [
      0.703125,
      0.703125
    ],
    "preserved": [
      "SOPInstanceUID",
      "SeriesInstanceUID",
      "FrameOfReferenceUID",
      "ImagePositionPatient",
      "ImageOrientationPatient",
      "PixelSpacing",
      "PerFrameFunctionalGroupsSequence",
      "TransferSyntaxUID",
      "raw_tags"
    ]
  },
  "variants": [
    {
      "dir": "variants/orientation_non_orthogonal",
      "kind": "orientation_non_orthogonal",
      "changed_source": "ImageOrientationPatient",
      "expect": "row·col = 0.196 > ortho_tol"
    },
    {
      "dir": "variants/duplicate_position",
      "kind": "duplicate_position",
      "changed_source": "ImagePositionPatient",
      "expect": "two frames share projection coordinate"
    },
    {
      "dir": "variants/spacing_jump",
      "kind": "spacing_jump",
      "changed_source": "ImagePositionPatient",
      "expect": "local gap 3.0mm vs nominal 1.0mm"
    },
    {
      "dir": "variants/multiframe_object",
      "kind": "multiframe_object",
      "changed_source": "PerFrameFunctionalGroupsSequence",
      "expect": "3 frames from one object"
    },
    {
      "dir": "variants/uid_conflict",
      "kind": "uid_conflict",
      "changed_source": "SOPInstanceUID/FrameOfReferenceUID",
      "expect": "same SOP uid different pixels; same series uid across two FoR"
    },
    {
      "dir": "variants/missing_geometry",
      "kind": "missing_geometry",
      "changed_source": "ImagePositionPatient/ImageOrientationPatient/PixelSpacing",
      "expect": "instance kept in place with diagnostic, excluded from spatial sort"
    },
    {
      "dir": "variants/unsupported_transfer_syntax",
      "kind": "unsupported_transfer_syntax",
      "changed_source": "TransferSyntaxUID",
      "expect": "raw bytes preserved, pixel decode skipped"
    }
  ],
  "scenario": [
    {
      "step": 1,
      "kind": "baseline_import",
      "dir": "baseline"
    },
    {
      "step": 2,
      "kind": "param_revision",
      "change": {
        "spacing_jump_tol_mm": [
          0.25,
          2.5
        ]
      },
      "expect": "invalidation limited to candidates whose residuals depend on spacing tolerance"
    },
    {
      "step": 3,
      "kind": "source_amend",
      "dir": "scenario/03_source_amend",
      "amends_sop_instance_uid": "1.2.826.0.1.3680043.9.7433.30.1.3",
      "expect": "only candidates containing that instance are invalidated"
    },
    {
      "step": 4,
      "kind": "conflicting_decisions",
      "expect": "second submitter sees version conflict with both diffs"
    }
  ],
  "rules": {
    "instance_number_not_spatial_truth": true,
    "orientation_orthogonality_checked_first": true,
    "ortho_tol": 0.01,
    "spacing_jump_tol_mm": 0.25,
    "duplicate_position_tol_mm": 0.01,
    "branches_not_merges": [
      "spacing_jump",
      "duplicate_position",
      "frame_of_reference_mismatch"
    ]
  }
}